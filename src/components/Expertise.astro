---
import SectionIntro from "./ui/SectionIntro.astro";
import TagList from "./ui/TagList.astro";
import Icon from "./ui/Icon.astro";
import databaseIcon from "../icons/database.svg?raw";
import browserIcon from "../icons/browser.svg?raw";
import chipIcon from "../icons/chip.svg?raw";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// One hand-drawn line icon per card, so each type of work reads at a glance
// instead of as an undifferentiated numbered list.
const cards = [
  { key: "expertise.cards.0", tagCount: 4, icon: databaseIcon },
  { key: "expertise.cards.1", tagCount: 4, icon: browserIcon },
  { key: "expertise.cards.2", tagCount: 3, icon: chipIcon },
];
---

<section
  class="max-w-content mx-auto px-6 py-24 md:py-36 scroll-mt-28"
  id="expertise"
>
  <SectionIntro index="01" i18nKey="expertise" />

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
    {
      cards.map((card) => (
        <article
          class="glass min-h-96 md:min-h-auto p-8 rounded-card"
          data-reveal
        >
          <div class="flex justify-center">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-lg border border-border bg-tint text-blue">
              <Icon svg={card.icon} class="w-7 h-7" />
            </span>
          </div>
          <h3 class="mt-8 text-2xl tracking-subheading">
            {t(`${card.key}.title`)}
          </h3>
          <p class="text-muted text-base leading-body">
            {t(`${card.key}.description`)}
          </p>
          <TagList i18nKey={`${card.key}.tags`} count={card.tagCount} accent />
        </article>
      ))
    }
  </div>
</section>

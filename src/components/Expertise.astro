---
import SectionIntro from "./ui/SectionIntro.astro";
import TagList from "./ui/TagList.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Hand-drawn line icons (same stroke="currentColor" convention as the
// header's theme toggle / back-to-top arrow) — one per card, so each type of
// work reads at a glance instead of as an undifferentiated numbered list.
const cards = [
  {
    key: "expertise.cards.0",
    tagCount: 4,
    // Database/server stack — APIs & persistence.
    icon: '<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path><path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"></path>',
  },
  {
    key: "expertise.cards.1",
    tagCount: 4,
    // Browser window — dashboards & admin tools.
    icon: '<rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><path d="M8 21h8"></path><path d="M12 17v4"></path>',
  },
  {
    key: "expertise.cards.2",
    tagCount: 3,
    // CPU chip with pins — embedded / Linux / ARM.
    icon: '<rect x="6" y="6" width="12" height="12" rx="1"></rect><path d="M9 2v3M12 2v3M15 2v3M9 19v3M12 19v3M15 19v3M2 9h3M2 12h3M2 15h3M19 9h3M19 12h3M19 15h3"></path>',
  },
];
---

<section
  class="max-w-content mx-auto px-6 py-24 md:py-36 scroll-mt-28"
  id="expertise"
>
  <SectionIntro index="01" i18nKey="expertise" />

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
    {
      cards.map((card) => (
        <article
          class="glass min-h-96 md:min-h-auto p-8 rounded-card transition duration-300 hover:-translate-y-1.5"
          data-reveal
        >
          <div class="flex justify-center">
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-lg border border-border bg-tint text-blue">
              <svg
                class="w-7 h-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={card.icon}
              />
            </span>
          </div>
          <h3 class="mt-8 text-2xl tracking-subheading">
            {t(`${card.key}.title`)}
          </h3>
          <p class="text-muted text-base leading-body">
            {t(`${card.key}.description`)}
          </p>
          <TagList i18nKey={`${card.key}.tags`} count={card.tagCount} accent />
        </article>
      ))
    }
  </div>
</section>

---
import Eyebrow from "./ui/Eyebrow.astro";
import DetailLabel from "./ui/DetailLabel.astro";
import TagList from "./ui/TagList.astro";
import Icon from "./ui/Icon.astro";
import DashboardMockup from "./visuals/DashboardMockup.astro";
import targetIcon from "../icons/target.svg?raw";
import personIcon from "../icons/person.svg?raw";
import layersIcon from "../icons/layers.svg?raw";
import chipIcon from "../icons/chip.svg?raw";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const protocolCount = 6;
const constraintCount = 4;

// One hand-drawn line icon per detail column, so "the challenge / my role /
// the tech / the constraints" reads as distinct highlights instead of blocks
// of identical small text.
const detailIcons = {
  challenge: targetIcon,
  role: personIcon,
  tech: layersIcon,
  constraints: chipIcon,
};
---

<section
  class="max-w-content mx-auto px-6 pt-28 pb-36 md:pt-20 scroll-mt-28"
  id="work"
>
  <div class="md:grid grid-cols-2 gap-20 items-end max-w-none">
    <div>
      <Eyebrow index="02" i18nKey="selectedWork" />
      <h2 class="text-h2 leading-heading-tight tracking-heading mb-4">
        {t("selectedWork.heading")}
      </h2>
    </div>
    <p class="text-muted leading-body self-end">
      {t("selectedWork.description")}
    </p>
  </div>

  <article class="project" data-reveal>
    <div
      class="flex justify-between items-center font-mono text-xs tracking-label text-dim border-b border-border pb-4"
    >
      <span>{t("selectedWork.meta")}</span>
      <span>{t("selectedWork.tags")}</span>
    </div>
    <div class="flex justify-between items-end mt-10 mb-8">
      <div>
        <h3
          class="mb-4 text-[calc(var(--text-h2)*1.25)] leading-display tracking-heading"
        >
          {t("selectedWork.titleLead")}<br /><em>{t("selectedWork.titleEm")}</em
          >
        </h3>
        <p class="max-w-xl text-muted">{t("selectedWork.description2")}</p>
      </div>
      <span class="text-blue text-2xl">↗</span>
    </div>

    <DashboardMockup />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8">
      <div class="glass p-7 rounded-2xl" data-reveal>
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <Icon svg={detailIcons.challenge} class="w-5 h-5" />
          </span>
          <DetailLabel
            i18nKey="selectedWork.details.challengeLabel"
            class="mb-0"
          />
        </div>
        <p class="text-muted text-base leading-body">
          {t("selectedWork.details.challenge")}
        </p>
      </div>
      <div class="glass p-7 rounded-2xl" data-reveal>
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <Icon svg={detailIcons.role} class="w-5 h-5" />
          </span>
          <DetailLabel i18nKey="selectedWork.details.roleLabel" class="mb-0" />
        </div>
        <p class="text-muted text-base leading-body">
          {t("selectedWork.details.role")}
        </p>
      </div>
    </div>

    <div class="glass mt-5 p-7 md:p-9 rounded-2xl" data-reveal>
      <div class="flex items-center gap-3 mb-4">
        <span
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
        >
          <Icon svg={detailIcons.tech} class="w-5 h-5" />
        </span>
        <DetailLabel i18nKey="selectedWork.details.techLabel" class="mb-0" />
      </div>
      <TagList i18nKey="selectedWork.details.tags" count={7} accent />

      <div class="mt-8 pt-8 border-t border-border">
        <DetailLabel i18nKey="selectedWork.integration.label" />
        <h4
          class="max-w-xl mb-4 text-2xl md:text-[28px] leading-heading tracking-subheading"
        >
          {t("selectedWork.integration.heading")}
        </h4>
        <p class="max-w-2xl mb-8 text-muted text-base leading-body">
          {t("selectedWork.integration.description")}
        </p>
        <div
          class="protocol-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3"
        >
          {
            Array.from({ length: protocolCount }, (_, i) => (
              <div class="min-h-32 p-5 rounded-xl border border-border bg-tint">
                <strong class="block font-mono text-lg">
                  {t(`selectedWork.integration.protocols.${i}.name`)}
                </strong>
                <span class="block mt-8 text-dim text-xs">
                  {t(`selectedWork.integration.protocols.${i}.description`)}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="glass mt-5 p-7 md:p-9 rounded-2xl" data-reveal>
      <div class="flex items-center gap-3 mb-4">
        <span
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
        >
          <Icon svg={detailIcons.constraints} class="w-5 h-5" />
        </span>
        <DetailLabel i18nKey="selectedWork.constraints.label" class="mb-0" />
      </div>
      <h4
        class="max-w-xl mb-4 text-2xl md:text-[28px] leading-heading tracking-subheading"
      >
        {t("selectedWork.constraints.heading")}
      </h4>
      <p class="max-w-2xl mb-8 text-muted text-base leading-body">
        {t("selectedWork.constraints.description")}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-border">
        {
          Array.from({ length: constraintCount }, (_, i) => (
            <div
              class:list={[
                "flex justify-between gap-8 py-4 border-b border-border",
                i % 2 === 0 && "sm:pr-8",
              ]}
            >
              <span class="font-mono text-xs text-blue">
                {t(`selectedWork.constraints.rows.${i}.label`)}
              </span>
              <strong class="text-sm font-semibold">
                {t(`selectedWork.constraints.rows.${i}.value`)}
              </strong>
            </div>
          ))
        }
      </div>
    </div>
  </article>
</section>

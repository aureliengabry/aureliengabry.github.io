---
import Eyebrow from "./ui/Eyebrow.astro";
import DetailLabel from "./ui/DetailLabel.astro";
import TagList from "./ui/TagList.astro";
import DashboardMockup from "./visuals/DashboardMockup.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const protocolCount = 6;

// Hand-drawn line icons (same stroke="currentColor" convention as
// Expertise.astro's cards) — one per detail column, so "the challenge / my
// role / the tech" reads as three distinct highlights instead of three
// identical blocks of small text.
const detailIcons = {
  // Target — the problem to hit.
  challenge:
    '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1"></circle>',
  // Person — who did the work.
  role: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>',
  // Stacked layers — the tech stack.
  tech: '<polygon points="12 3 3 8 12 13 21 8 12 3"></polygon><polyline points="3 16 12 21 21 16"></polyline><polyline points="3 12 12 17 21 12"></polyline>',
};
---

<section
  class="max-w-content mx-auto px-6 md:pt-24 py-36 scroll-mt-28"
  id="work"
>
  <div class="md:grid grid-cols-2 gap-20 items-end max-w-none">
    <div>
      <Eyebrow index="02" i18nKey="selectedWork" />
      <h2 class="text-h2 leading-heading-tight tracking-heading mb-5">
        {t("selectedWork.heading")}
      </h2>
    </div>
    <p class="text-muted leading-body-loose self-end">
      {t("selectedWork.description")}
    </p>
  </div>

  <article class="project" data-reveal>
    <div
      class="flex justify-between items-center font-mono text-xs tracking-label text-dim border-b border-border pb-4"
    >
      <span>{t("selectedWork.meta")}</span>
      <span>{t("selectedWork.tags")}</span>
    </div>
    <div class="flex justify-between items-end mt-10 mb-8">
      <div>
        <h3
          class="mb-4 text-[clamp(42px,6vw,76px)] leading-display tracking-heading"
        >
          {t("selectedWork.titleLead")}<br /><em>{t("selectedWork.titleEm")}</em
          >
        </h3>
        <p class="max-w-xl text-muted">{t("selectedWork.description2")}</p>
      </div>
      <span class="text-blue text-2xl">↗</span>
    </div>

    <DashboardMockup />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8">
      <div
        class="glass p-7 rounded-2xl transition duration-300 hover:-translate-y-1"
        data-reveal
      >
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={detailIcons.challenge}
            />
          </span>
          <DetailLabel
            i18nKey="selectedWork.details.challengeLabel"
            class="mb-0"
          />
        </div>
        <p class="text-muted text-base leading-body">
          {t("selectedWork.details.challenge")}
        </p>
      </div>
      <div
        class="glass p-7 rounded-2xl transition duration-300 hover:-translate-y-1"
        data-reveal
      >
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={detailIcons.role}
            />
          </span>
          <DetailLabel i18nKey="selectedWork.details.roleLabel" class="mb-0" />
        </div>
        <p class="text-muted text-base leading-body">
          {t("selectedWork.details.role")}
        </p>
      </div>
      <div
        class="glass p-7 rounded-2xl transition duration-300 hover:-translate-y-1"
        data-reveal
      >
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={detailIcons.tech}
            />
          </span>
          <DetailLabel i18nKey="selectedWork.details.techLabel" class="mb-0" />
        </div>
        <TagList i18nKey="selectedWork.details.tags" count={7} accent />
      </div>
    </div>

    <div class="mt-16 pt-16 border-t border-border">
      <DetailLabel
        i18nKey="selectedWork.integration.label"
        prefixI18nKey="selectedWork.details.techLabel"
      />
      <h4
        class="max-w-xl mb-4 text-2xl md:text-[28px] leading-heading tracking-subheading"
      >
        {t("selectedWork.integration.heading")}
      </h4>
      <p class="max-w-2xl mb-8 text-muted text-base leading-body">
        {t("selectedWork.integration.description")}
      </p>
      <div
        class="protocol-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3"
      >
        {
          Array.from({ length: protocolCount }, (_, i) => (
            <div
              class="glass min-h-36 p-6 rounded-2xl transition duration-300 hover:-translate-y-1"
              data-reveal
            >
              <strong class="block font-mono text-lg">
                {t(`selectedWork.integration.protocols.${i}.name`)}
              </strong>
              <span class="block mt-11 text-dim text-xs">
                {t(`selectedWork.integration.protocols.${i}.description`)}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </article>
</section>

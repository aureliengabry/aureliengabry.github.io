---
import Eyebrow from "./ui/Eyebrow.astro";
import DetailLabel from "./ui/DetailLabel.astro";
import Icon from "./ui/Icon.astro";
import DashboardMockup from "./visuals/DashboardMockup.astro";
import targetIcon from "../icons/target.svg?raw";
import personIcon from "../icons/person.svg?raw";
import layersIcon from "../icons/layers.svg?raw";
import chipIcon from "../icons/chip.svg?raw";
import databaseIcon from "../icons/database.svg?raw";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const constraintCount = 4;
const integrationItemCount = 4;

// One icon per detail column so each reads as a distinct highlight.
const detailIcons = {
  challenge: targetIcon,
  role: personIcon,
  tech: layersIcon,
  constraints: chipIcon,
};

// The three components the architecture is built from, in reading order,
// each tied to its physical unit.
const architectureNodes = [
  {
    icon: targetIcon,
    labelKey: "selectedWork.integration.nodes.0.label",
    deviceKey: "selectedWork.integration.nodes.0.device",
    tags: [4, 5, 3].map((i) =>
      t(`selectedWork.integration.protocols.${i}.name`),
    ),
  },
  {
    icon: databaseIcon,
    labelKey: "selectedWork.integration.nodes.1.label",
    deviceKey: "selectedWork.integration.nodes.1.device",
    tags: ["Python", "React", "Docker", "Linux / ARM"],
  },
  {
    icon: chipIcon,
    labelKey: "selectedWork.integration.nodes.2.label",
    deviceKey: "selectedWork.integration.nodes.2.device",
    tags: [0, 1, 2].map((i) =>
      t(`selectedWork.integration.protocols.${i}.name`),
    ),
  },
];
---

<section
  class="max-w-content mx-auto px-6 pt-24 pb-24 md:pt-36 md:pb-36 scroll-mt-28"
  id="work"
>
  <div class="md:grid grid-cols-2 gap-20 items-end max-w-none mb-12">
    <div>
      <Eyebrow index="02" i18nKey="selectedWork" />
      <h2 class="text-h2 leading-heading-tight tracking-heading font-bold mb-4">
        {t("selectedWork.heading")}
      </h2>
    </div>
    <p class="text-muted text-base md:text-lg leading-body self-end">
      {t("selectedWork.description")}
    </p>
  </div>

  <article class="project">
    <div
      class="flex justify-between items-center font-mono text-xs tracking-label text-dim border-b border-border pb-4"
    >
      <span>{t("selectedWork.meta")}</span>
      <span>{t("selectedWork.tags")}</span>
    </div>
    <div class="flex justify-between items-end mt-10 mb-10 md:mb-16">
      <h3
        class="text-[calc(var(--text-h2)*1.25)] leading-display tracking-heading font-bold"
      >
        {t("selectedWork.titleLead")} <em>{t("selectedWork.titleEm")}</em>
      </h3>
    </div>

    <!-- Placed before the dashboard so the reader has context (the
         challenge, the role) before a screen full of numbers. -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-7 md:gap-x-0 md:divide-x md:divide-border"
    >
      <div class="md:pr-8">
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <Icon svg={detailIcons.challenge} class="w-5 h-5" />
          </span>
          <h4 class="text-base md:text-lg font-bold">
            {t("selectedWork.details.challengeLabel")}
          </h4>
        </div>
        <p class="text-muted text-base md:text-lg leading-body">
          {t("selectedWork.details.challenge")}
        </p>
      </div>
      <div class="md:pl-8">
        <div class="flex items-center gap-3 mb-4">
          <span
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
          >
            <Icon svg={detailIcons.role} class="w-5 h-5" />
          </span>
          <h4 class="text-base md:text-lg font-bold">
            {t("selectedWork.details.roleLabel")}
          </h4>
        </div>
        <p class="text-muted text-base md:text-lg leading-body">
          {t("selectedWork.details.role")}
        </p>
      </div>
    </div>

    <!-- Hidden below md to match DashboardMockup, which is hidden md:block too. -->
    <div class="hidden md:block md:mt-16">
      <p class="text-muted text-base md:text-lg leading-body">
        {t("selectedWork.dashboardIntro")}
      </p>
      <div class="mt-4">
        <DashboardMockup />
      </div>
    </div>

    <!-- Short labelled items instead of one dense paragraph, so each part
         of the stack is scannable on its own. -->
    <div class="mt-10 md:mt-16 pt-10 border-t border-border">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
            >
              <Icon svg={detailIcons.tech} class="w-5 h-5" />
            </span>
            <DetailLabel
              i18nKey="selectedWork.integration.label"
              class="mb-0"
            />
          </div>
          <h4
            class="mb-4 text-2xl md:text-[28px] leading-heading tracking-subheading font-bold"
          >
            {t("selectedWork.integration.heading")}
          </h4>
          <div class="flex flex-col gap-5">
            {
              Array.from({ length: integrationItemCount }, (_, i) => (
                <div>
                  <DetailLabel
                    i18nKey={`selectedWork.integration.items.${i}.label`}
                    class="mb-1"
                  />
                  <p class="text-muted text-base md:text-lg leading-body">
                    {t(`selectedWork.integration.items.${i}.description`)}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Panel sized to its own content (w-fit), not the full column,
             so the frame hugs the diagram instead of the empty column width. -->
        <div class="flex justify-center">
          <div class="glass rounded-2xl p-4 md:p-5 w-fit">
            <div class="flex items-center justify-center gap-2 mb-5">
              <span class="h-px w-8 bg-border" aria-hidden="true" />
              <span class="font-mono text-xs font-semibold tracking-widest text-blue">
                ITxPT
              </span>
              <span class="text-dim text-xs md:text-sm">
                {t("selectedWork.integration.badge")}
              </span>
              <span class="h-px w-8 bg-border" aria-hidden="true" />
            </div>
            <div class="flex flex-col gap-2">
              {
                architectureNodes.map((node, i) => (
                  <>
                    {i > 0 && (
                      <div
                        class="flex items-center justify-center text-blue text-xl"
                        aria-hidden="true"
                      >
                        ↓
                      </div>
                    )}
                    <div class="px-3 py-2 text-center">
                      <div class="flex justify-center mb-3">
                        <span class="inline-flex items-center justify-center w-12 h-12 rounded-lg border border-border bg-tint text-blue">
                          <Icon svg={node.icon} class="w-6 h-6" />
                        </span>
                      </div>
                      <strong class="block text-base md:text-lg font-bold">
                        {t(node.labelKey)}
                      </strong>
                      <span class="block mt-0.5 font-mono text-xs md:text-sm text-blue">
                        {t(node.deviceKey)}
                      </span>
                      <span class="block mt-2 font-mono text-xs md:text-sm text-dim">
                        {node.tags.join(" · ")}
                      </span>
                    </div>
                  </>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Plain label/value table, no outer card, for rhythm variety. -->
    <div class="mt-10 md:mt-16 pt-10 border-t border-border">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
            >
              <Icon svg={detailIcons.constraints} class="w-5 h-5" />
            </span>
            <DetailLabel
              i18nKey="selectedWork.constraints.label"
              class="mb-0"
            />
          </div>
          <h4
            class="mb-4 text-2xl md:text-[28px] leading-heading tracking-subheading font-bold"
          >
            {t("selectedWork.constraints.heading")}
          </h4>
          <p class="text-muted text-base md:text-lg leading-body">
            {t("selectedWork.constraints.description")}
          </p>
        </div>
        <table class="w-full border-collapse text-left">
          <tbody class="divide-y divide-border">
            {
              Array.from({ length: constraintCount }, (_, i) => (
                <tr>
                  <td class="py-3.5 pr-4 align-top font-mono text-xs md:text-sm text-blue whitespace-nowrap">
                    {t(`selectedWork.constraints.rows.${i}.label`)}
                  </td>
                  <td class="py-3.5 text-sm md:text-base font-semibold">
                    {t(`selectedWork.constraints.rows.${i}.value`)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Same visual weight as the beats above, not a small dim aside. -->
    <div class="mt-10 md:mt-16 pt-10 border-t border-border">
      <div class="flex items-center gap-3 mb-4">
        <span
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border bg-tint text-blue shrink-0"
        >
          <Icon svg={detailIcons.tech} class="w-5 h-5" />
        </span>
        <DetailLabel i18nKey="selectedWork.otherProjectsLabel" class="mb-0" />
      </div>
      <p class="max-w-2xl text-muted text-base md:text-lg leading-body">
        {t("selectedWork.otherProjects")}
      </p>
    </div>
  </article>
</section>

---
import Icon from "./Icon.astro";
import backToTopIcon from "../../icons/back-to-top.svg?raw";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button
  type="button"
  class="back-to-top fixed bottom-6 right-6 z-10 inline-flex w-16 h-16 items-center justify-center rounded-full border border-border bg-raise text-text opacity-0 pointer-events-none shadow-raised transition duration-300 hover:-translate-y-0.5 hover:border-border-strong back-top-visible:opacity-100 back-top-visible:pointer-events-auto"
  aria-label={t("common.backToTop")}
>
  <Icon svg={backToTopIcon} class="w-6 h-6" />
</button>

<script>
  const backToTop = document.querySelector(".back-to-top");

  window.addEventListener(
    "scroll",
    () => {
      backToTop?.classList.toggle("visible", window.scrollY > 400);
    },
    { passive: true },
  );

  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

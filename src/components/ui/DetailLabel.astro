---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  i18nKey: string;
  /** Overrides the default bottom margin for callers that lay the label out
   * inline (e.g. next to an icon) instead of stacked above a paragraph. */
  class?: string;
}

const { i18nKey, class: className = "mb-3" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<p
  class:list={[
    "detail-label font-mono text-sm font-semibold tracking-widest text-blue",
    className,
  ]}
>
  {t(i18nKey)}
</p>

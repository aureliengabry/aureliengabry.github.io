---
import Eyebrow from "./Eyebrow.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  index: string;
  i18nKey: string;
}

const { index, i18nKey } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="max-w-3xl mb-12">
  <Eyebrow index={index} i18nKey={i18nKey} />
  <h2 class="text-h2 leading-heading-tight tracking-heading mb-4">
    {t(`${i18nKey}.heading`)}
  </h2>
  <p class="max-w-3xl text-muted text-base leading-body">
    {t(`${i18nKey}.description`)}
  </p>
</div>

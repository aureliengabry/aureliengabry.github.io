---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  i18nKey: string;
  count: number;
  /** Renders the first tag in the site's accent blue instead of the neutral
   * tag color — used once, on Expertise's embedded-systems card, to make its
   * lead tag ("Linux / ARM") stand out rather than blend into the rest. */
  accentFirst?: boolean;
}

const { i18nKey, count, accentFirst = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tags = Array.from({ length: count }, (_, i) => t(`${i18nKey}.${i}`));
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag, i) => (
      <span
        class:list={[
          "rounded-md border px-2 py-1.5 font-mono text-xs",
          accentFirst && i === 0
            ? "border-blue/30 bg-blue/10 text-blue font-semibold"
            : "border-border bg-tint text-tag",
        ]}
      >
        {tag}
      </span>
    ))
  }
</div>
